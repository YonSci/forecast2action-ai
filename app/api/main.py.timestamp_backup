        {"task_id": f"{slugify(district)}_task_3", "rank": 3, "action": "Coordinate preparedness and resource pre-positioning with relevant sectors.", "basis": "Early action can reduce livelihood and service disruption.", "responsible_sector": "DRM / Water / Agriculture", "priority": "Medium", "suggested_deadline": "Within 14 days", "status": "Not started"},
