def deterministic_noise(*parts: object) -> float:
    text = "|".join(str(part) for part in parts)
    value = sum((idx + 1) * ord(char) for idx, char in enumerate(text))
    return (math.sin(value) + 1.0) / 2.0


def forecast_lead_factor(lead: str) -> float:
    if lead.startswith("week"):
        return 0.08 * int(re.sub(r"\D", "", lead)[:1] or 1)
    if lead.startswith("month"):
        return 0.12 * int(re.sub(r"\D", "", lead) or 1)
    return 0.1


def grid_cell_values(lat: float, lon: float, forecast_scale: str, lead: str) -> dict:
    n1 = deterministic_noise(lat, lon, forecast_scale, lead, "a")
    n2 = deterministic_noise(lon, lat, forecast_scale, lead, "b")
    n3 = deterministic_noise(lat + lon, forecast_scale, lead, "c")

    dry_hotspot = max(0.0, 1.0 - math.sqrt((lat - 6.5) ** 2 + (lon - 42.0) ** 2) / 5.8)
    wet_hotspot = max(0.0, 1.0 - math.sqrt((lat - 12.0) ** 2 + (lon - 37.0) ** 2) / 4.0)
    lead_boost = forecast_lead_factor(lead)

    hazard_probability = min(0.98, max(0.05, 0.20 + 0.55 * dry_hotspot + 0.25 * n1 + lead_boost / 5))
    exposure = min(0.95, max(0.15, 0.30 + 0.35 * n2 + 0.25 * dry_hotspot))
    vulnerability = min(0.95, max(0.20, 0.35 + 0.35 * n3 + 0.20 * dry_hotspot))
    risk_score = min(1.0, max(0.0, 0.42 * hazard_probability + 0.28 * exposure + 0.24 * vulnerability + 0.06 * n1))

    spi = round(-2.3 * dry_hotspot + 1.2 * wet_hotspot + (n1 - 0.5) * 0.8, 2)
    rainfall_anomaly_pct = round(-45 * dry_hotspot + 35 * wet_hotspot + (n2 - 0.5) * 20, 1)
    rainfall_percentile = round(max(1, min(99, 50 + rainfall_anomaly_pct * 0.8)), 1)
    cdd = int(max(0, min(45, 8 + 28 * dry_hotspot + 8 * n3)))
    cwd = int(max(0, min(25, 2 + 16 * wet_hotspot + 5 * n1)))

    if risk_score >= 0.80:
        risk_level = "trigger"
    elif risk_score >= 0.60:
        risk_level = "warning"
    elif risk_score >= 0.35:
        risk_level = "watch"
    else:
        risk_level = "no_alert"

    if dry_hotspot > 0.55:
        hazard = "drought"
    elif rainfall_anomaly_pct < -20:
        hazard = "dry_spell"
    elif wet_hotspot > 0.6:
        hazard = "heavy_rainfall"
    elif rainfall_anomaly_pct > 20:
        hazard = "wet_spell"
    else:
        hazard = "no_alert"

    return {
        "forecast_scale": forecast_scale,
        "lead": lead,
        "lead_label": LEAD_LABELS.get(lead, lead),
        "lat_center": round(lat, 3),
        "lon_center": round(lon, 3),
        "hazard": hazard,
        "risk_level": risk_level,
        "risk_score": round(risk_score, 3),
        "hazard_probability": round(hazard_probability, 3),
        "exposure": round(exposure, 3),
        "vulnerability": round(vulnerability, 3),
        "spi": spi,
        "rainfall_anomaly_pct": rainfall_anomaly_pct,
        "rainfall_percentile": rainfall_percentile,
        "cdd": cdd,
        "cwd": cwd,
    }


@lru_cache(maxsize=64)
def load_ethiopia_forecast_grid(forecast_scale: str = "subseasonal", lead: str = "week_1") -> dict:
    if forecast_scale not in VALID_FORECAST_SCALES:
        forecast_scale = "subseasonal"
    if lead not in VALID_FORECAST_LEADS:
        lead = "week_1"

    features = []
    size = 0.5
    lats = np.arange(ETHIOPIA_DOMAIN["lat_min"] + 0.25, ETHIOPIA_DOMAIN["lat_max"], size)
    lons = np.arange(ETHIOPIA_DOMAIN["lon_min"] + 0.25, ETHIOPIA_DOMAIN["lon_max"], size)
    for lat in lats:
        for lon in lons:
            props = grid_cell_values(float(lat), float(lon), forecast_scale, lead)
            features.append(make_square_feature(float(lon), float(lat), size, props))

    return {
        "type": "FeatureCollection",
        "metadata": {"forecast_scale": forecast_scale, "lead": lead, "feature_count": len(features), **ETHIOPIA_DOMAIN},
        "features": features,
    }


