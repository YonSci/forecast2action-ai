def load_task_status() -> dict:
    ensure_dirs()
    if not TASK_STATUS_PATH.exists():
        TASK_STATUS_PATH.write_text("{}", encoding="utf-8")
    return json.loads(TASK_STATUS_PATH.read_text(encoding="utf-8") or "{}")


def save_task_status(status: dict) -> None:
    ensure_dirs()
    TASK_STATUS_PATH.write_text(json.dumps(status, indent=2), encoding="utf-8")


def apply_task_status(tasks: list[dict]) -> list[dict]:
    status_lookup = load_task_status()
    for task in tasks:
        if task["task_id"] in status_lookup:
            task.update(status_lookup[task["task_id"]])
    return tasks


def summarize_tasks(tasks: list[dict]) -> dict:
    counts = Counter(task.get("status", "Not started") for task in tasks)
    return {"total_tasks": len(tasks), "not_started": counts.get("Not started", 0), "in_progress": counts.get("In progress", 0), "completed": counts.get("Completed", 0), "blocked": counts.get("Blocked", 0)}


@app.get("/api/action-tracker/{district}")
def get_action_tracker(district: str, audience: str = "disaster_manager", language: str = "en"):
    tasks = apply_task_status(build_action_tasks(district))
    return {"district": district, "audience": audience, "language": language, "tasks": tasks, "summary": summarize_tasks(tasks)}


@app.patch("/api/action-tracker/status")
def update_action_tracker_status(update: TaskStatusUpdate):
    status = load_task_status()
    status[update.task_id] = {"status": update.status, "updated_by": update.updated_by}
    save_task_status(status)
    return {"status": "updated", "task_id": update.task_id}


@app.get("/api/action-tracker/{district}/csv")
def download_action_tracker_csv(district: str, audience: str = "disaster_manager", language: str = "en"):
    tasks = apply_task_status(build_action_tasks(district))
    output = StringIO()
    writer = csv.DictWriter(output, fieldnames=["rank", "task_id", "action", "responsible_sector", "priority", "suggested_deadline", "status", "basis"])
    writer.writeheader()
    for task in tasks:
        writer.writerow(task)
    output.seek(0)
    return StreamingResponse(iter([output.getvalue()]), media_type="text/csv", headers={"Content-Disposition": f"attachment; filename=forecast2action_action_tracker_{slugify(district)}.csv"})


@app.get("/api/advisory/{district}")
def get_advisory(district: str, audience: str = "disaster_manager", language: str = "en"):
    risk = next((item for item in load_risk_data() if item.get("district") == district), None)
    if not risk:
        risk = {"district": district, "hazard": "drought", "risk_level": "watch", "risk_score": 0.5}
    text = f"{district} is under {risk.get('risk_level')} level for {risk.get('hazard')}. Prioritize local verification, warning dissemination, and early action coordination."
    return {"district": district, "role_specific_advisory": text, "recommended_actions": ["Verify local conditions", "Disseminate advisory", "Coordinate early action"], "community_message": text}


@app.get("/api/bulletin/{district}")
def get_bulletin(district: str, output_format: str = "html", audience: str = "disaster_manager", language: str = "en"):
    advisory = get_advisory(district, audience, language)
    if output_format == "markdown":
        return PlainTextResponse(f"# Forecast2Action Bulletin: {district}\n\n{advisory['role_specific_advisory']}\n")
    return HTMLResponse(f"<html><body><h1>Forecast2Action Bulletin: {district}</h1><p>{advisory['role_specific_advisory']}</p></body></html>")
