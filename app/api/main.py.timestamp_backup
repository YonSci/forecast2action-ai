def slugify(value: str) -> str:
    text = str(value or "").strip().lower()
    text = re.sub(r"[^a-z0-9]+", "_", text)
    return text.strip("_") or "unknown"


def clean_text(value, default: str = "") -> str:
    if value is None:
        return default
    text = str(value).strip()
    if text.lower() in {"", "nan", "none", "null"}:
        return default
    return text


def first_existing(props: dict, candidates: list[str], default: str = "") -> str:
    lower = {str(k).lower(): k for k in props.keys()}
    for candidate in candidates:
        key = lower.get(candidate.lower())
        if key is not None:
            value = clean_text(props.get(key))
            if value:
                return value
    for key, value in props.items():
        key_lower = str(key).lower()
        if any(candidate.lower() in key_lower for candidate in candidates):
            value = clean_text(value)
            if value:
                return value
    return default


def safe_float(value, default: float = 0.0) -> float:
    try:
        number = float(value)
        if math.isnan(number) or math.isinf(number):
            return default
        return number
    except (TypeError, ValueError):
        return default


def mean_value(values: list) -> float:
    valid = [safe_float(v) for v in values if v is not None]
    return sum(valid) / len(valid) if valid else 0.0


def most_common_value(values: list, default: str = "no_alert") -> str:
    cleaned = [str(v) for v in values if v is not None and str(v) != ""]
    if not cleaned:
        return default
    return Counter(cleaned).most_common(1)[0][0]


def make_square_feature(lon: float, lat: float, size: float, properties: dict) -> dict:
    half = size / 2
    return {
        "type": "Feature",
        "properties": properties,
        "geometry": {
            "type": "Polygon",
            "coordinates": [[
                [lon - half, lat - half], [lon + half, lat - half],
                [lon + half, lat + half], [lon - half, lat + half],
                [lon - half, lat - half],
            ]],
        },
    }


