@app.get("/api/community-feedback-summary")
def community_feedback_summary():
    by_district = {}
    for report in load_reports():
        district = report.get("district", "Unknown")
        summary = by_district.setdefault(district, {"district": district, "total_reports": 0, "feedback_signal": "no_ground_signal"})
        summary["total_reports"] += 1
        if report.get("severity") == "high":
            summary["feedback_signal"] = "strong_ground_signal"
        elif summary["feedback_signal"] == "no_ground_signal":
            summary["feedback_signal"] = "limited_ground_signal"
    return {"by_district": by_district, "summaries": list(by_district.values())}


