@lru_cache(maxsize=8)
def load_admin_features(level: str) -> tuple:
    if level not in ADMIN_SHP_PATHS:
        level = "admin1"

    shp_path = ADMIN_SHP_PATHS[level]
    if gpd is None or not shp_path.exists():
        return tuple(fallback_admin_features(level))

    gdf = gpd.read_file(shp_path)
    if gdf.crs is not None and str(gdf.crs).lower() not in {"epsg:4326", "wgs84"}:
        gdf = gdf.to_crs("EPSG:4326")

    geojson = json.loads(gdf.to_json())
    standardized = []

    for feature in geojson.get("features", []):
        props = feature.get("properties", {}) or {}

        region = first_existing(props, ["region", "reg_name", "adm1_en", "adm1_name", "name_1", "admin1", "adm1"], "")
        zone = first_existing(props, ["zone", "zon_name", "adm2_en", "adm2_name", "name_2", "admin2", "adm2"], "")
        woreda = first_existing(props, ["woreda", "wereda", "wrd_name", "adm3_en", "adm3_name", "name_3", "admin3", "adm3"], "")

        if level == "admin1":
            if not region:
                region = first_existing(props, ["name", "shapeName", "adm1_en", "name_1"], "Region")
            zone = ""
            woreda = ""
            name = region
        elif level == "admin2":
            if not zone:
                zone = first_existing(props, ["name", "shapeName", "adm2_en", "name_2"], "Zone")
            if not region:
                region = first_existing(props, ["adm1_en", "name_1", "region"], "")
            woreda = ""
            name = zone
        else:
            if not woreda:
                woreda = first_existing(props, ["name", "shapeName", "adm3_en", "name_3"], "Woreda")
            if not zone:
                zone = first_existing(props, ["adm2_en", "name_2", "zone"], "")
            if not region:
                region = first_existing(props, ["adm1_en", "name_1", "region"], "")
            name = woreda

        region_id = slugify(region)
        zone_id = f"{region_id}__{slugify(zone)}" if zone else ""
        woreda_id = f"{zone_id}__{slugify(woreda)}" if woreda and zone_id else ""

        feature["properties"] = {
            **props,
            "admin_level": level,
            "name": name,
            "region": region,
            "zone": zone,
            "woreda": woreda,
            "region_id": region_id,
            "zone_id": zone_id,
            "woreda_id": woreda_id,
        }
        standardized.append(feature)

    return tuple(standardized)


def admin_feature_collection(features: list[dict], level: str, **metadata) -> dict:
    return {
        "type": "FeatureCollection",
        "metadata": {"level": level, "feature_count": len(features), **metadata},
        "features": features,
    }


def filter_admin_features(features: list[dict], region_id: str = "", zone_id: str = "", woreda_id: str = "") -> list[dict]:
    filtered = []
    for feature in features:
        props = feature.get("properties", {})
        if region_id and props.get("region_id") != region_id:
            continue
        if zone_id and props.get("zone_id") != zone_id:
            continue
        if woreda_id and props.get("woreda_id") != woreda_id:
            continue
        filtered.append(feature)
    return filtered


